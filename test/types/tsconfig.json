{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": false,
    "types": []
  },
  "include": ["./**/*.ts"]
}
